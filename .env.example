# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# ── Flask ───────────────────────────────────────────────────────────────────
# Generate a fresh random key, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# ── External data root (sensitive patient data) ─────────────────────────────
# Absolute path to the directory that contains the `sources/` subfolder and
# `sampled_cases.csv`. NOT committed to git — share via internal file service.
# Example (Windows):
#   DATA_ROOT="C:\\Users\\<you>\\Desktop\\Data"
# Example (Linux/macOS):
#   DATA_ROOT="/home/<you>/data"
DATA_ROOT=
SOURCES_SUBDIR=sources
OUTPUTS_SUBDIR=outputs
CSV_FILENAME=sampled_cases.csv

# ── Local LLM endpoint (OpenAI-compatible; needed for preprocess.py and
#    generate_highlights.py) ───────────────────────────────────────────────
# Point this at your LOCAL inference server (e.g. vLLM / llama.cpp / Ollama).
# No third-party provider is used.
LLM_BASE_URL="http://localhost:8000/v1"
LLM_MODEL="your-model-id"
LLM_API_KEY=""

# ── Optional: push notifications via ntfy.sh (no login required) ────────────
# NTFY_URL=https://ntfy.sh/your-private-topic
NTFY_URL=

# ── Problem-report recipient ────────────────────────────────────────────────
# The "Problem melden" button in the evaluation opens the user's mail client
# pre-filled (username, case, step) addressed to this address. If left empty,
# the mail opens with an empty "To" field.
SUPPORT_EMAIL=

# ── Test mode ────────────────────────────────────────────────────────────────
# Set TEST_MODE=1 to run the app against the self-contained test case(s) in
# test_case/ instead of the real study cohort (for UI familiarization).
# Case data, responses and exports are isolated under test_case/, a "TESTMODUS"
# banner is shown, and the case count follows the test pool automatically.
# Leave empty (or 0) for the real study. Switching requires an app restart.
TEST_MODE=
