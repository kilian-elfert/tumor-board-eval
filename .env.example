# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# ── Flask ───────────────────────────────────────────────────────────────────
# Generate a fresh random key, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# ── External data root (sensitive patient data) ─────────────────────────────
# Absolute path to the directory that contains the `sources/` subfolder and
# `sampled_cases.csv`. NOT committed to git — share via internal file service.
# Example (Windows):
#   DATA_ROOT="C:\\Users\\<you>\\Desktop\\Data"
# Example (Linux/macOS):
#   DATA_ROOT="/home/<you>/data"
DATA_ROOT=
SOURCES_SUBDIR=sources
OUTPUTS_SUBDIR=outputs
CSV_FILENAME=sampled_cases.csv

# ── LLM endpoint (only needed for preprocess.py / regenerating dashboards) ──
LLM_BASE_URL="http://10.99.0.230:8004/v1"
LLM_MODEL="openai/gpt-oss-120b"
LLM_API_KEY=

# ── Optional: Groq (used by filter_fragestellungen.py) ──────────────────────
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_API_KEY=

# ── Optional: push notifications via ntfy.sh (no login required) ────────────
# NTFY_URL=https://ntfy.sh/your-private-topic
NTFY_URL=
